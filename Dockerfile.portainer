# Portainer: Images > Build a new image > Web editor.
# Select samsa-source.tar.gz as an additional build file.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
ADD samsa-source.tar.gz /app/
RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 notifier \
    && mkdir /app/keys \
    && chmod +x /app/docker-entrypoint.sh \
    && chown -R notifier:notifier /app

USER notifier
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4)"
CMD ["./docker-entrypoint.sh"]
